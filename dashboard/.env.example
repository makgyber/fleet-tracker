# Laravel API base URL
VITE_API_URL=http://127.0.0.1:8000/api

# Mapbox public token (pk....) for the map tiles
VITE_MAPBOX_TOKEN=

# Firebase web app config (Project settings > General > Your apps > Web).
# Leave blank to run the dashboard in "REST-only" mode (no live updates).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
